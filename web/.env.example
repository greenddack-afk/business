# 필수
ANTHROPIC_API_KEY=

# 초대 코드 (배포 시 REQUIRE_INVITE=1 권장: 코드 설정이 빠져도 전부 거부된다)
REQUIRE_INVITE=1
INVITE_CODES=ABCD-EFGH-JKMN:시범1,PQRS-TUVW-XYZ2:시범2

# 사용 횟수 저장소 (Vercel Marketplace의 Upstash Redis를 연결하면 자동으로 들어온다)
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN 또는 KV_REST_API_URL / KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택: 횟수 제한 (0이면 그 제한은 끈다)
# LIFETIME_LIMIT_PER_CODE=5
# DAILY_LIMIT_PER_CODE=0
# DAILY_LIMIT_TOTAL=30

# 선택: 모델
# FAST_MODEL=claude-haiku-4-5-20251001
# SMART_MODEL=claude-sonnet-5
# CRITIC_MODEL=
# SYNTH_MODEL=
